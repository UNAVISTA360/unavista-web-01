    <script>
        // Inicializar Iconos Lucide
        lucide.createIcons();

        // Gemini API Configuration
        const apiKey = ""; // La clave se inyectará en tiempo de ejecución
        const model = "gemini-2.5-flash-preview-09-2025";
        const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`;

        // Utility: Gemini API Call with Exponential Backoff
        async function callGemini(prompt, systemInstruction = "") {
            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                systemInstruction: { parts: [{ text: systemInstruction }] }
            };

            let delay = 1000;
            for (let i = 0; i < 5; i++) {
                try {
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        const data = await response.json();
                        return data.candidates?.[0]?.content?.parts?.[0]?.text || "No se pudo generar una respuesta.";
                    }
                } catch (error) {
                    // Retry
                }
                await new Promise(resolve => setTimeout(resolve, delay));
                delay *= 2;
            }
            throw new Error("Error al conectar con la IA tras varios intentos.");
        }

        // Consultor de Proyectos IA
        async function consultProject() {
            const description = document.getElementById('project-description').value.trim();
            if (!description) {
                alertCustom("Por favor, describe tu proyecto para que la IA pueda ayudarte.");
                return;
            }

            const btnText = document.getElementById('btn-text');
            const btnLoading = document.getElementById('btn-loading');
            const responseContainer = document.getElementById('ia-response-container');
            const responseText = document.getElementById('ia-response-text');

            btnText.classList.add('hidden');
            btnLoading.classList.remove('hidden');

            const systemPrompt = "Eres el Consultor Inteligente de UNAVISTA. Tu objetivo es analizar la idea del cliente y recomendar una combinación estratégica de nuestros servicios: Drone FPV 4K, Fotografía 360 e Impresión 3D. Sé profesional, creativo y enfocado en la innovación tecnológica. Responde en español, usando un tono premium y estructurando la respuesta en párrafos cortos.";

            try {
                const result = await callGemini(`Analiza el siguiente proyecto y propón una solución integral usando servicios de UNAVISTA: ${description}`, systemPrompt);
                
                // Formatear un poco la respuesta
                const formattedResult = result.split('\n').filter(p => p.trim()).map(p => `<p>${p}</p>`).join('');
                
                responseText.innerHTML = formattedResult;
                responseContainer.classList.remove('hidden');
                responseContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (error) {
                alertCustom("Lo sentimos, hubo un problema al procesar tu propuesta. Por favor intenta de nuevo más tarde.");
            } finally {
                btnText.classList.remove('hidden');
                btnLoading.classList.add('hidden');
            }
        }

        function alertCustom(message) {
            // Reemplazo de alert() por un log o pequeño UI si fuera necesario
            console.log("UNAVISTA IA:", message);
            const msgBox = document.createElement('div');
            msgBox.className = "fixed bottom-10 left-1/2 -translate-x-1/2 bg-fucsia text-white px-6 py-3 rounded-full z-[100] font-bold text-xs shadow-xl animate-bounce";
            msgBox.innerText = message;
            document.body.appendChild(msgBox);
            setTimeout(() => msgBox.remove(), 3000);
        }

        // Control Navbar al Scroll
        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            window.scrollY > 80 ? navbar.classList.add('scrolled') : navbar.classList.remove('scrolled');
        });

        // Revelación al Scroll
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // Animación Inicial Hero
        window.addEventListener('load', () => {
            setTimeout(() => {
                document.querySelectorAll('section:first-of-type .reveal').forEach((el, i) => {
                    setTimeout(() => el.classList.add('active'), i * 150);
                });
            }, 300);
        });
    </script>
