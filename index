<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UNAVISTA | Capturando el Mundo, Creando el Futuro</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --turquesa: #32c5cf;
            --fucsia: #ff007f;
            --blanco-roto: #f1f5f9;
            --negro-puro: #000000;
            --gris-profundo: #0a0a0a;
            --gris-tarjeta: #111827;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--negro-puro);
            color: var(--blanco-roto);
            overflow-x: hidden;
        }

        /* Patrón WAVE minimalista (zigzag) */
        .wave-pattern {
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='20' viewBox='0 0 100 20' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 15 L12.5 5 L25 15 L37.5 5 L50 15 L62.5 5 L75 15 L87.5 5 L100 15' fill='none' stroke='%2332c5cf' stroke-width='1' opacity='0.15'/%3E%3C/svg%3E");
        }

        /* Navbar Dinámico */
        #navbar.scrolled {
            background-color: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(12px);
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(50, 197, 207, 0.2);
        }

        /* Enlaces Navbar */
        .nav-link {
            position: relative;
            transition: color 0.3s ease;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -4px;
            left: 0;
            background-color: var(--fucsia);
            transition: width 0.3s ease;
        }
        .nav-link:hover { color: var(--fucsia); }
        .nav-link:hover::after { width: 100%; }

        /* Botón CTA */
        .btn-cta {
            background-color: var(--fucsia);
            color: white;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 15px rgba(255, 0, 127, 0.4);
        }
        .btn-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 0, 127, 0.6);
        }

        /* Animaciones de Entrada */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s ease-out;
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Tarjetas de Servicios */
        .service-card {
            background-color: var(--gris-tarjeta);
            border: 1px solid rgba(50, 197, 207, 0.1);
            transition: all 0.4s ease;
        }
        .service-card:hover {
            border-color: var(--turquesa);
            transform: translateY(-8px);
            box-shadow: 0 15px 35px -15px rgba(50, 197, 207, 0.3);
        }

        /* Portafolio Overlay */
        .portfolio-overlay {
            background: linear-gradient(to top, var(--turquesa) 0%, rgba(50, 197, 207, 0.4) 100%);
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        .portfolio-item:hover .portfolio-overlay {
            opacity: 0.95;
        }

        /* AI Chat Styles */
        .ai-glow {
            box-shadow: 0 0 20px rgba(50, 197, 207, 0.2);
            border: 1px solid rgba(50, 197, 207, 0.3);
        }
        .loading-spinner {
            border: 2px solid rgba(50, 197, 207, 0.1);
            border-top: 2px solid var(--turquesa);
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
